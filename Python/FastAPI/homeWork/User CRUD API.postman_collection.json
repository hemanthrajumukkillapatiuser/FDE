{
  "info": {
    "_postman_id": "6256107e-fd62-47ee-af63-3ebd70c0573e",
    "name": "FastAPI User CRUD",
    "description": "Exercise the file-backed user CRUD API. Run requests in order to create a user, then fetch, replace, update, and delete it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get all users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns all users', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get user by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns the requested user', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.variables.get('userId')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test User\",\n  \"username\": \"postman.test\",\n  \"email\": \"postman.test@example.com\",\n  \"phone\": \"555-0100\",\n  \"website\": \"example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Creates a user', function () {",
              "    pm.response.to.have.status(201);",
              "    const user = pm.response.json();",
              "    pm.expect(user.id).to.be.a('number');",
              "    pm.collectionVariables.set('userId', String(user.id));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Replace user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Replaced User\",\n  \"username\": \"postman.replaced\",\n  \"email\": \"postman.replaced@example.com\",\n  \"phone\": \"555-0101\",\n  \"website\": \"example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Replaces the user', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().name).to.eql('Postman Replaced User');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Patch user",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Updated User\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Updates only the supplied fields', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().name).to.eql('Postman Updated User');",
              "    pm.expect(pm.response.json().email).to.eql('postman.replaced@example.com');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deletes the user', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.variables.get('userId')));",
              "    pm.collectionVariables.set('userId', '1');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ]
}
